<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Title>RhinoIfc</Title>
    <Description>Simple IFC import/export for Rhino</Description>
    <Version>0.1.0</Version>
    <Authors>YourName</Authors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- RhinoCommon from McNeel NuGet feed -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon SDK — do not copy to output, Rhino provides it at runtime -->
    <PackageReference Include="RhinoCommon" Version="8.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- xBIM — IFC parsing, entity model, geometry tessellation -->
    <PackageReference Include="Xbim.Essentials" Version="6.0.578" />
    <PackageReference Include="Xbim.Geometry" Version="5.1.820" />
    <PackageReference Include="Xbim.Tessellator" Version="6.0.521" />
  </ItemGroup>

</Project>
