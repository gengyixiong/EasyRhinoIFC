<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Title>EasyRhinoIFC</Title>
    <AssemblyTitle>EasyRhinoIFC</AssemblyTitle>
    <Product>EasyRhinoIFC</Product>
    <Description>IFC4 export for Rhino</Description>
    <Version>0.2.2</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <Authors>EasyRhinoIFC Contributors</Authors>
    <TargetExt>.rhp</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Xbim.Essentials" Version="6.0.578" />
  </ItemGroup>
  <Target Name="CopyBrandedPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)EasyRhinoIFC.rhp" SkipUnchangedFiles="true" />
  </Target>
</Project>
